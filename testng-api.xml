<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="API Suite" parallel="classes" thread-count="3">

    <!--
        No <listeners> block: io.qameta.allure.testng.AllureTestNg auto-registers
        via TestNG SPI (META-INF/services/org.testng.ITestNGListener) shipped in
        the allure-testng jar. The mobile suite (testng.xml) declares it
        explicitly for legacy reasons; here we rely on SPI.
    -->

    <test name="API Tests">
        <classes>
            <class name="com.kennyramadhan.qa.tests.api.ProductsApiTest"/>
            <class name="com.kennyramadhan.qa.tests.api.BrandsApiTest"/>
            <class name="com.kennyramadhan.qa.tests.api.AuthApiTest"/>
            <class name="com.kennyramadhan.qa.tests.api.UserApiTest"/>
        </classes>
    </test>
</suite>
